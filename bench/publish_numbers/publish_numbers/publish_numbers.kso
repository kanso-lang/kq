import "std/io"
import "std/list"
import "std/math"
import "std/text"

# Everything the README publishes is regenerated here, on every pull request.
#
# The allocator counters are deterministic to the byte, so a runner reproduces
# them exactly. The wall clock is not, and does not need to be: the claim is
# kq against jq, both binaries alternating on the same box under the same
# contention, averaged over rounds. What a shared runner cannot give is an
# absolute millisecond anybody should quote; what it gives perfectly well is
# which of two programs is faster and by how much, which is the whole of what
# the table says.
#
# The race itself runs in the workflow, because timing a subprocess is the one
# thing this program cannot do without a clock of its own; it lands in
# bench/.race.txt and is spliced in here.
fixture = "bench/large.json"

grown = "bench/.scale_x10.json"

out = "bench/MEASURED.md"

readme = "README.md"

opened = "<!-- measured:begin"

raced = "bench/.race.txt"

race_opened = "<!-- raced:begin"

race_closed = "<!-- raced:end -->"

closed = "<!-- measured:end -->"

pub play = spread

spread = io/read_file fixture . widened

fn widened text
  body = text/trim text
  inner = text/slice body 2 (length body - 1)
  io/write_file grown (ten_times inner) . (_ -> gathered)

fn ten_times inner
  five = "{inner},{inner},{inner},{inner},{inner}"
  "[{five},{five}]"

gathered = counted fixture . (small -> against small)

fn against small
  counted grown . (big -> written small big)

fn counted path
  io/run "env" ["KANSO_COUNTERS=1" "./kq" "." path] . (r -> pairs_of r.stderr)

fn pairs_of text
  lines = list/select (text/split text "\n") counter?
  list/to_list (list/map lines pair_of)

fn counter? line
  parts = text/split line "="
  length parts == 2 and numeric? parts[2]!

fn pair_of line
  parts = text/split line "="
  [parts[1]! (text/to_int parts[2]!)]

fn name_of p
  p[1]!

fn value_of p
  p[2]!

fn digit? c
  c >= "0" and c <= "9"

fn numeric? v
  length v > 0 and list/all? (text/chars v) digit?

fn lookup pairs name
  list/find pairs (p -> name_of p == name)

fn found_value none
  0

fn found_value pair
  value_of pair

fn written small big
  rows = list/to_list (list/map small (p -> row_for p big))
  body = "{header}{text/join rows "\n"}\n{footer}"
  io/write_file out body . (_ -> spliced (ratio_rows small big))

# The README is what a reader lands on, so every row it carries is written
# here: the counters a runner reproduces exactly, then the race the workflow
# just ran.
fn spliced rows
  io/read_file readme . (text -> counted text rows) . (_ -> timed)

fn counted text rows
  io/write_file readme (rewritten text rows)

fn rewritten text rows
  halves = text/split text opened
  tail = text/split halves[2]! closed
  "{halves[1]!}{banner}{text/join rows "\n"}\n\n{closed}{tail[2]!}"

# The wall-clock table is a dated sitting on a quiet box, moved by hand: a
# shared runner is a different machine every run and interleaving cannot
# cancel that. So there is normally no race file, and asking is how one finds
# out — a read that fails answers an err, which no arm here could catch.
timed = io/exists raced . reading

fn reading false
  print "no race this run — the wall-clock table is a hand sitting"

fn reading true
  io/read_file raced . laps

fn laps text
  io/read_file readme . (page -> raced_into page text)

fn raced_into page text
  io/write_file readme (with_race page (race_rows text))

# Four lines, one per lane, written by the workflow: label, kq ms, jq ms.
fn race_rows text
  lines = list/reject (text/split (text/trim text) "\n") (l -> l == "")
  text/join (list/to_list (list/map lines lap_row)) "\n"

fn lap_row line
  parts = text/split line "\t"
  "| {parts[1]!} | {parts[2]!} ms | {parts[3]!} ms | {faster parts} |"

fn faster parts
  k = text/to_float parts[2]!
  j = text/to_float parts[3]!
  ahead (j / k) (k < j)

fn ahead r true
  "kq {two_places r}x faster"

fn ahead r false
  "jq {two_places (1.0 / r)}x faster"

# Kanso renders a float with as many digits as it needs; a column wants two.
fn two_places x
  units = math/round (x * 100.0)
  whole = units / 100
  frac = units - whole * 100
  "{whole}.{padded "{frac}"}"

fn padded s
  widened s (length s == 1)

fn widened s true
  "0{s}"

fn widened s false
  s

fn with_race page rows
  halves = text/split page race_opened
  tail = text/split halves[2]! race_closed
  "{halves[1]!}{race_banner}{rows}\n\n{race_closed}{tail[2]!}"

race_banner = """
  <!-- raced:begin — every pull request races the two binaries; edit
       bench/publish_numbers, not this -->

  kq against jq 1.7.1, both alternating on the same runner under the same
  contention, five rounds, averaged. A shared box cannot hand out an absolute
  millisecond worth quoting; it compares two programs on one machine perfectly
  well, which is what this says.

  | workload | kq | jq 1.7.1 | |
  |---|---:|---:|---|
"""

banner = """
  <!-- measured:begin — regenerated by bench/publish_numbers.kso on every push;
       edit that, not this -->

  Deterministic allocator counters, regenerated by CI on every commit. Every
  figure reproduces on any machine, and `ratio` is ten times the document over
  the 188 KB fixture — work that is linear in the input lands near 10.

  | counter | 188 KB | 2.1 MB | ratio |
  |---|---:|---:|---|
"""

fn ratio_rows small big
  list/to_list (list/map (list/select small watched?) (p -> row_for p big))

# The whole counter set belongs in bench/MEASURED.md; the README carries the
# handful a reader is actually deciding on.
watched = ["allocs" "alloc_bytes" "arena_peak_bytes" "carry_dedup"]

held = ["view_allocs" "view_frees"]

fn watched? pair
  named = name_of pair
  list/any? (text/concat watched held) (n -> n == named)

header = """
  # measured

  Regenerated by CI on every commit — every figure here is an allocator
  counter, deterministic to the byte on any machine. The wall-clock and
  hardware-counter tables in README.md are a dated sitting on a quiet box and
  are moved by hand; bench/numbers_gate.kso refuses to let them outlive the
  compiler they were measured against.

  `ratio` is the 2.1 MB fixture over the 188 KB one, ten times the document.
  Work that is linear in the input lands near 10.

  | counter | 188 KB | 2.1 MB | ratio |
  |---|---:|---:|---|
"""

footer = """

  The 2.1 MB fixture is ten flat copies of bench/large.json's elements, built
  at measurement time, so every row reproduces from what the repo carries.
"""

fn row_for pair big
  before = value_of pair
  after = found_value (lookup big (name_of pair))
  "| `{name_of pair}` | {before} | {after} | {ratio before after} |"

fn ratio 0 _
  "—"

fn ratio before after
  tenths (after * 10 / before)

fn tenths n
  "{n / 10}.{n % 10}x"
