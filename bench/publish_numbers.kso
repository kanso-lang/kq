import "std/io"
import "std/list"
import "std/text"

# The README carries a sitting: wall time and hardware counters from a quiet
# machine, dated, moved by a person. A shared runner cannot reproduce either —
# the counters are macOS `/usr/bin/time -l` and the clock is whatever else the
# box is doing — so publishing those every commit would publish noise wearing a
# number's clothes.
#
# What a runner CAN measure exactly is the allocator counters, which are
# deterministic to the byte, and the ratio between two document sizes. Those go
# here, regenerated on every commit, so the machine-checkable half of the claim
# is never stale and never depends on anybody remembering to re-sit it.
#
# bench/numbers_gate.kso is the other half: it refuses to let the README's
# hand-sat rows outlive the compiler they were measured against.
fixture = "bench/large.json"

grown = "bench/.scale_x10.json"

out = "bench/MEASURED.md"

pub play = spread

spread = io/read_file fixture . widened

fn widened text
  body = text/trim text
  inner = text/slice body 2 (length body - 1)
  io/write_file grown (ten_times inner) . (_ -> gathered)

fn ten_times inner
  five = "{inner},{inner},{inner},{inner},{inner}"
  "[{five},{five}]"

gathered = counted fixture . (small -> against small)

fn against small
  counted grown . (big -> written small big)

fn counted path
  io/run "env" ["KANSO_COUNTERS=1" "./kq" "." path] . (r -> pairs_of r.stderr)

fn pairs_of text
  lines = list/select (text/split text "\n") counter?
  list/to_list (list/map lines pair_of)

fn counter? line
  parts = text/split line "="
  length parts == 2 and numeric? parts[2]!

fn pair_of line
  parts = text/split line "="
  [parts[1]! (text/to_int parts[2]!)]

fn name_of p
  p[1]!

fn value_of p
  p[2]!

fn digit? c
  c >= "0" and c <= "9"

fn numeric? v
  length v > 0 and list/all? (text/chars v) digit?

fn lookup pairs name
  list/find pairs (p -> name_of p == name)

fn found_value none
  0

fn found_value pair
  value_of pair

fn written small big
  rows = list/to_list (list/map small (p -> row_for p big))
  io/write_file out "{header}{text/join rows "\n"}\n{footer}"

header = """
  # measured

  Regenerated by CI on every commit — every figure here is an allocator
  counter, deterministic to the byte on any machine. The wall-clock and
  hardware-counter tables in README.md are a dated sitting on a quiet box and
  are moved by hand; bench/numbers_gate.kso refuses to let them outlive the
  compiler they were measured against.

  `ratio` is the 2.1 MB fixture over the 188 KB one, ten times the document.
  Work that is linear in the input lands near 10.

  | counter | 188 KB | 2.1 MB | ratio |
  |---|---:|---:|---|
"""

footer = """

  The 2.1 MB fixture is ten flat copies of bench/large.json's elements, built
  at measurement time, so every row reproduces from what the repo carries.
"""

fn row_for pair big
  before = value_of pair
  after = found_value (lookup big (name_of pair))
  "| `{name_of pair}` | {before} | {after} | {ratio before after} |"

fn ratio 0 _
  "—"

fn ratio before after
  tenths (after * 10 / before)

fn tenths n
  "{n / 10}.{n % 10}x"
