import "std/text"

type defect
  reason

pub type decimal
  literal

pub type json_null

pub type parse_failure
  position
  reason

type parsed
  pos
  value

pub fn decode s
  cs = text/bytes s
  finish cs (parse_value cs 1)

# one byte accumulator threads the whole tree, so every emitted byte is
# copied once into the builder and once into the final string
fn elem_onto acc x
  encode_onto (text/append acc 44) x

pub fn encode v
  text/utf8 (encode_onto (text/bytes "") v)

fn encode_items acc xs i
  return acc if i < 1 or length xs < i
  encode_items (elem_onto acc xs[i]) xs (i + 1)

fn encode_list acc xs
  return acc if length xs < 1
  opened = encode_onto (text/append acc 91) xs[1]
  text/append (encode_items opened xs 2) 93

# A map is written from its two columns: `keys m` and `values m` are in the
# order `entries m` gives, so position i of each is one pair, and the walk
# indexes both rather than building and taking apart a record per pair.
fn encode_map acc ks vs
  return text/append acc "\{}" if length ks == 0 or length vs == 0
  opened = entry_onto (text/append acc 123) ks[1] vs[1]
  text/append (encode_pairs opened ks vs 2) 125

fn encode_onto acc true
  text/append acc "true"

fn encode_onto acc false
  text/append acc "false"

fn encode_onto acc json_null
  text/append acc "null"

fn encode_onto acc (decimal lit)
  text/append acc (canonical lit)

fn encode_onto acc n:int
  text/append acc "{n}"

fn encode_onto acc x:float64
  text/append acc "{x}"

fn encode_onto acc s:string
  opened = escape_onto (text/append acc 34) s
  text/append opened 34

fn encode_onto acc xs:[]some
  if (length xs == 0) (text/append acc "[]") (encode_list acc xs)

fn encode_onto acc m:map[string some]
  encode_map acc (keys m) (values m)

fn encode_pairs acc ks vs i
  return acc if i < 1 or length ks < i or length vs < i
  encode_pairs (pair_onto acc ks[i] vs[i]) ks vs (i + 1)

fn entry_onto acc k v
  keyed = encode_onto acc k
  encode_onto (text/append keyed 58) v

pub fn failure_position (err (parse_failure p _))
  p

pub fn failure_position _
  0

pub fn failure_reason (err (parse_failure _ reason))
  reason

pub fn failure_reason _
  ""

fn finish _ none
  err (parse_failure 0 "unexpected end of input")

fn finish cs (parsed p v)
  p2 = skip_ws cs p
  if (p2 > length cs) v (fail p2 "unexpected trailing characters")

# A failure inside the value is handed on as it is. The arm is written down
# because the checker asks for it: an err is a value, and a group with no arm
# for one where one can arrive does not compile.
fn finish _ e@(err _)
  e

fn must (err reason)
  err (defect "{reason}")

fn must v
  v

fn pair_onto acc k v
  entry_onto (text/append acc 44) k v
