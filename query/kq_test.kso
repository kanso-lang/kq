import "std/text"

test_path_trail =
  trail = (path -> encode path == "[\"users\",4,\"name\"]")
  parse_path ".users[3].name" .> trail

test_encode_shorthands =
  raw = text/utf8 [120 8 121 12 122]
  encode raw == "\"x\\by\\fz\""

test_decimal_boundary =
  pair = "{canonical "6.946505e-06"} {canonical "1e-7"}"
  pair == "0.000006946505 1E-7"

test_decimal_trailing =
  trio = "{canonical "10e2"} {canonical "1.50"} {canonical "-0.0"}"
  trio == "1.0E+3 1.50 -0.0"

test_decimal_wide = canonical "99999999999999999999" == "99999999999999999999"

test_decode_surrogate_pair = decodes? "\"\\ud83c\\udf8c\"" "🎌"

# A document that does not decode is a failure, which `==` hands on, so the
# test fails with it.
fn decodes? text want
  decode text == want

test_pretty_list = decode "[1,2]" .> (doc -> pretty doc 0 == "[\n  1,\n  2\n]")

test_pretty_map =
  sorted = (doc -> pretty doc 0 == "\{\n  \"a\": 1,\n  \"b\": 2\n}")
  decode "\{\"b\":2,\"a\":1}" .> sorted

test_pretty_scalar = pretty 42 0 == "42"

test_walk =
  found = (doc path -> encode (walk doc path) == "7")
  on = (doc -> parse_path ".a[0].b" .> (path -> found doc path))
  decode "\{\"a\":[\{\"b\":7}]}" .> on
