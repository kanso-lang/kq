import "std/text"

test_path_trail =
  path = parse_path ".users[3].name"
  trail = encode path
  trail == "[\"users\",4,\"name\"]"

test_encode_shorthands =
  raw = text/utf8 [120 8 121 12 122]
  encode raw == "\"x\\by\\fz\""

test_decimal_boundary =
  pair = "{canonical "6.946505e-06"} {canonical "1e-7"}"
  pair == "0.000006946505 1E-7"

test_decimal_trailing =
  trio = "{canonical "10e2"} {canonical "1.50"} {canonical "-0.0"}"
  trio == "1.0E+3 1.50 -0.0"

test_decimal_wide = canonical "99999999999999999999" == "99999999999999999999"

test_decode_surrogate_pair = decodes? "\"\\ud83c\\udf8c\"" "🎌"

# `decode` answers an err for bad input and `==` wants a value, so a test
# dispatches on what it decoded before comparing it.
fn decodes? text want
  same? (decode text) want

fn same? (err _) _
  false

fn same? got want
  got == want

test_pretty_list =
  doc = must (decode "[1,2]")
  pretty doc 0 == "[\n  1,\n  2\n]"

test_pretty_map =
  doc = must (decode "\{\"b\":2,\"a\":1}")
  rendered = pretty doc 0
  rendered == "\{\n  \"a\": 1,\n  \"b\": 2\n}"

test_pretty_scalar = pretty 42 0 == "42"

test_walk =
  doc = must (decode "\{\"a\":[\{\"b\":7}]}")
  path = parse_path ".a[0].b"
  found = walk doc path
  encode found == "7"
