import "std/io"
import "std/os"
import "std/text"

fn apply text query
  render_result (walk (decode text) (parse_path query))

fn elem_chunk v lead
  text/utf8 (pretty_onto (text/append (text/bytes lead) "  ") v 1)

pub fn dispatch argv
  if (length argv == 0) usage (with_query argv)

fn render_result (err reason)
  err reason

# the whole document never becomes one string: each top-level element is
# rendered, written, and dead before the next is built
fn render_result xs:[]some
  if (length xs == 0) (print "[]") (stream_list xs)

fn render_result v
  print (pretty v 0)

fn sep 1
  ""

fn sep _
  ",\n"

fn stream_elems xs i
  if (length xs < i) (io/write "\n]\n") (stream_one xs i)

fn stream_list xs
  io/write "[\n" . (_ -> stream_elems xs 1)

fn stream_one xs i
  io/write (elem_chunk xs[i] (sep i)) . (_ -> stream_elems xs (i + 1))

usage = print "usage: kq <path> [file.json]   e.g. kq .users[3].name data.json"

fn with_query argv
  source = if (length argv > 1) (os/read_file argv[2]) io/stdin
  source . (t -> queried t argv[1])

# A path the user typed may not name a file, so absence arrives as data and is
# matched here rather than insisted on with `read_file!`. That is Clay's
# ruling of 2026-09-03 in the case it was made for: "if you know it's possible
# for them to not be there, you wouldn't use an exception, you'd just return a
# file_not_found type."
#
# The arm writes and exits rather than raising. An `err` at kq's endpoint
# renders as `error[endpoint]: unhandled err reached the executor: [...]`,
# which is a diagnostic about kq rather than a sentence for the person who
# typed the name.
fn queried (file_not_found f) _
  io/write_err "kq: no such file: {f}\n" . (_ -> os/exit 1)

fn queried text query
  apply text query
