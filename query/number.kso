import "std/text"

# number bytes: + - . E e, then the ascii digits
fn number_char? 43
  true

fn number_char? 45
  true

fn number_char? 46
  true

fn number_char? 69
  true

fn number_char? 101
  true

fn number_char? none
  false

fn number_char? c
  47 < c and c < 58

fn number_end cs p
  if (number_char? cs[p]) (number_end cs (p + 1)) p

fn number_ok p (err _)
  fail p "invalid number"

fn number_ok _ n
  n

fn number_start? 45
  true

fn number_start? none
  false

fn number_start? c
  47 < c and c < 58

fn number_value cs p q
  number_ok p (decimal (text/utf8 (text/slice cs p q)))
